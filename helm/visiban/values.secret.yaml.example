# values.secret.yaml — secret overrides for Visiban Helm chart
#
# Copy this file to values.secret.yaml (which is gitignored) and fill in
# your production values. Pass it to Helm with:
#
#   helm install visiban helm/visiban \
#     -f helm/visiban/values.yaml \
#     -f helm/visiban/values.secret.yaml
#
# This keeps secrets out of shell history, process lists, and CI logs.
# NEVER commit values.secret.yaml to version control.

secret:
  djangoSecretKey: ""  # generate: python3 -c "import secrets; print(secrets.token_hex(50))"

postgresql:
  auth:
    password: ""  # strong random password

# Bundled Valkey password — only when valkey.auth.enabled is true (off by
# default). Or set valkey.auth.existingSecret instead; not both.
# valkey:
#   auth:
#     enabled: true
#     password: ""  # generate: openssl rand -hex 32

# External Valkey/Redis password — keep it out of externalRedis.url (rendered
# as a plain env value) by putting it in a Secret you create, and naming it:
# externalRedis:
#   existingSecret: visiban-redis  # key: redis-password

# SMTP credentials — optional. Left blank, a site admin configures email later
# in Admin → Settings → Email with no redeploy. Fill these in (and set
# backend.email.backend: "smtp") only for env-only email configuration; that
# pins the backend and disables the admin UI. See docs/getting-started/kubernetes.md.
backend:
  email:
    host: ""               # e.g. smtp.yourprovider.com
    port: 587
    user: ""
    password: ""           # SMTP password
    fromAddress: ""        # e.g. noreply@yourdomain.com
    useTls: true

# Uncomment and fill in providers you use — leave others blank to disable.
# backend:
#   oauth:
#     google:
#       clientId: ""
#       clientSecret: ""
#     github:
#       clientId: ""
#       clientSecret: ""
#     gitlab:
#       clientId: ""
#       clientSecret: ""
#     oidc:
#       serverUrl: "https://sso.example.com/realms/my-realm"
#       clientId: ""
#       clientSecret: ""
#       providerName: "SSO"
