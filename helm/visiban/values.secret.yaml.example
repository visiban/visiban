# values.secret.yaml — secret overrides for Visiban Helm chart
#
# Copy this file to values.secret.yaml (which is gitignored) and fill in
# your production values. Pass it to Helm with:
#
#   helm install visiban helm/visiban \
#     -f helm/visiban/values.yaml \
#     -f helm/visiban/values.secret.yaml
#
# This keeps secrets out of shell history, process lists, and CI logs.
# NEVER commit values.secret.yaml to version control.

secret:
  djangoSecretKey: ""  # generate: python3 -c "import secrets; print(secrets.token_hex(50))"

postgresql:
  auth:
    password: ""  # strong random password

# SMTP credentials. Required when backend.email.backend is "smtp" (default).
# Use backend.email.backend: "console" to skip SMTP and log mails to stdout.
backend:
  email:
    host: "smtp.yourprovider.com"
    port: 587
    user: "smtp-username"
    password: ""           # SMTP password
    fromAddress: "noreply@yourdomain.com"
    useTls: true

# Uncomment and fill in providers you use — leave others blank to disable.
# backend:
#   oauth:
#     google:
#       clientId: ""
#       clientSecret: ""
#     github:
#       clientId: ""
#       clientSecret: ""
#     gitlab:
#       clientId: ""
#       clientSecret: ""
#     oidc:
#       serverUrl: "https://sso.example.com/realms/my-realm"
#       clientId: ""
#       clientSecret: ""
#       providerName: "SSO"
