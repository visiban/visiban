# Demo instance settings (#1034). Copy the lines below into the repo-root .env
# of the demo host and replace every placeholder. Never commit the real file.
#
# Generate secrets with e.g.:  openssl rand -base64 36

# --- Hostname -----------------------------------------------------------------
DOMAIN=try.visiban.com
ALLOWED_HOSTS=try.visiban.com
CORS_ALLOWED_ORIGINS=https://try.visiban.com
FRONTEND_URL=https://try.visiban.com

# --- Secrets (required; placeholders intentionally fail review) ----------------
DJANGO_SECRET_KEY=REPLACE_ME
DB_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME

# --- Demo mode -----------------------------------------------------------------
# DEMO_MODE arms the deny-by-default write fence (#1179) and publishes the
# VISITOR credentials below on the login page via the public
# /api/v1/auth/site-config/ endpoint. The visitor is a non-admin member; the
# site admin's password is separate and never published. Throwaway host only.
DEMO_MODE=true
DEMO_LOGIN_USERNAME=visitor
# The password shown on the login page. Also the seeded visitor password.
DEMO_LOGIN_PASSWORD=REPLACE_ME
# The seeded site admin's password (username "admin"). Never published; must
# differ from DEMO_LOGIN_PASSWORD. Required.
DEMO_ADMIN_PASSWORD=REPLACE_ME
# Password for the two seeded member accounts (maya, jordan). Not published. Required.
DEMO_MEMBER_PASSWORD=REPLACE_ME
# Cron (UTC) of the reset — MUST match visiban-demo-reset.cron, because the
# login page and the in-app demo bar count down to it. This Compose path resets
# nightly; the backend's default is hourly (the Helm path, #1180).
DEMO_RESET_SCHEDULE=0 0 * * *

# --- Media -----------------------------------------------------------------------
# Caddy has no X-Accel-Redirect equivalent, so have Django stream attachments.
USE_X_ACCEL_REDIRECT=false

# --- Keep the demo self-contained ----------------------------------------------
# Registration is seeded closed (#1179), but no demo path should ever wait on
# an email round trip, and nothing may send real mail from a public instance.
EMAIL_VERIFICATION=none
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
# Do not configure OAuth/OIDC providers on the demo.
