# Demo instance settings (#1034). Copy the lines below into the repo-root .env
# of the demo host and replace every placeholder. Never commit the real file.
#
# Generate secrets with e.g.:  openssl rand -base64 36

# --- Hostname -----------------------------------------------------------------
DOMAIN=try.visiban.com
ALLOWED_HOSTS=try.visiban.com
CORS_ALLOWED_ORIGINS=https://try.visiban.com
FRONTEND_URL=https://try.visiban.com

# --- Secrets (required; placeholders intentionally fail review) ----------------
DJANGO_SECRET_KEY=REPLACE_ME
DB_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME

# --- Demo mode -----------------------------------------------------------------
# DEMO_MODE publishes the admin credentials below on the login page via the
# public /api/v1/auth/site-config/ endpoint. That is the intent — but it means
# the admin account is effectively public. Use only on a throwaway host.
DEMO_MODE=true
DEMO_LOGIN_USERNAME=admin
# The password shown in the login banner. Also the seeded admin password.
DEMO_LOGIN_PASSWORD=REPLACE_ME
# Password for the two seeded member accounts (maya, jordan). Not published. Required.
DEMO_MEMBER_PASSWORD=REPLACE_ME

# --- Media -----------------------------------------------------------------------
# Caddy has no X-Accel-Redirect equivalent, so have Django stream attachments.
USE_X_ACCEL_REDIRECT=false

# --- Keep the demo self-contained ----------------------------------------------
# Throwaway sign-ups must work without email round trips, and nothing may send
# real mail from a public admin account.
EMAIL_VERIFICATION=none
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
# Do not configure OAuth/OIDC providers on the demo.
