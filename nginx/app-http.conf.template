# HTTP-only nginx config — used when TLS_MODE=none.
#
# WARNING: This configuration serves Visiban over plain HTTP with no encryption.
# Do NOT use this for deployments reachable from the public internet.
# It is intended for air-gapped networks, internal staging environments, or
# deployments where TLS is terminated by an upstream load balancer.

# Map the Upgrade header to a Connection value so that:
#   - WebSocket requests (Upgrade: websocket) get Connection: upgrade
#   - Regular HTTP/1.1 keep-alive requests get Connection: close
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};

    add_header X-Frame-Options           SAMEORIGIN always;
    add_header X-Content-Type-Options    nosniff always;

    client_max_body_size 20M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Frontend static files (built React app)
    root  /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API
    location /api/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # django-allauth browser-based OAuth callbacks (e.g. /accounts/google/login/callback/)
    location /accounts/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # django-allauth headless API (OAuth callbacks, session endpoints)
    location /_allauth/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # WebSocket (Django Channels)
    location /ws/ {
        proxy_pass             http://backend:8000;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        proxy_read_timeout     86400s;
    }

    # Django admin — restricted to loopback only at the Nginx layer.
    # To access admin, SSH-tunnel to the server:
    #   ssh -L 8080:127.0.0.1:80 user@yourserver  then visit http://localhost:8080/admin/
    location /admin/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass       http://backend:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django-served static files
    location /static/ {
        proxy_pass http://backend:8000;
    }

    # Attachment downloads — proxied through Django for authentication and
    # board-membership checks. Django returns X-Accel-Redirect to hand off
    # the actual file transfer to Nginx without re-reading it through Python.
    location /media/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Internal-only location used by X-Accel-Redirect responses from Django.
    location /protected-media/ {
        internal;
        alias /app/media/;
    }
}
