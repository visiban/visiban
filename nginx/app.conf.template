# Map the Upgrade header to a Connection value so that:
#   - WebSocket requests (Upgrade: websocket) get Connection: upgrade
#   - Regular HTTP/1.1 keep-alive requests get Connection: close
# Without this map, proxying Connection: "upgrade" on non-upgrade requests
# breaks HTTP keep-alive and can prevent the backend from establishing
# WebSocket connections correctly.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Rate-limit zone for the Django admin login. Defense-in-depth even though
# /admin/ is already IP-restricted to loopback — 5 requests/min, burst 2.
limit_req_zone $binary_remote_addr zone=admin_login:1m rate=5r/m;

# Cache policy for the SPA (#1633). Keyed on $uri, which nginx rewrites to
# /index.html when try_files falls back, so SPA deep links (/boards/1) get
# the same policy as /. Done with a map + one server-level add_header rather
# than per-location add_header on purpose: any location that declares its own
# add_header silently drops every server-level one (HSTS, CSP, X-Frame-Options),
# and a map has no such side effect. An empty value emits no header at all, so
# the proxied locations are untouched.
#   - un-hashed entry files must be revalidated on every load, otherwise a
#     browser keeps a stale index.html that names hashed bundles which no
#     longer exist after a deploy and renders a blank page.
#   - Vite's hashed /assets/* never change content under the same name.
map $uri $visiban_cache_control {
    default                                              "";
    ~^/(index\.html|theme-init\.js|site\.webmanifest|favicon[^/]*|apple-touch-icon[^/]*|android-chrome-[^/]*)$   "no-cache";
    ~^/brand/                                            "no-cache";
    ~^/assets/                                           "public, max-age=31536000, immutable";
}

# Referrer-Policy fallback (#1531). Django sends its own Referrer-Policy on
# every response (and a stricter `no-referrer` on the password-reset key
# redirect, #1554). A server-level add_header would be appended to it and the
# browser would honor the LAST header, silently weakening the stricter one.
# So nginx only adds `same-origin` when the upstream sent none (static files,
# the SPA); when Django set one the value here is empty, which emits no header,
# and Django's passes through untouched.
map $upstream_http_referrer_policy $visiban_referrer_policy {
    default "";
    ""      "same-origin";
}

# HTTP — serve ACME challenge and redirect everything else to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    # HSTS (#1201): NOT hardcoded here. This used to be a bare `add_header
    # Strict-Transport-Security "max-age=63072000; includeSubDomains" always;`
    # sent unconditionally for both TLS_MODE=letsencrypt and TLS_MODE=selfsigned,
    # which contradicted the docs (selfsigned promises no HSTS by default so a
    # browser that has been told to trust the self-signed cert doesn't get
    # pinned to it for two years) and ignored an operator's SECURE_HSTS_SECONDS.
    # init-prod.sh calls scripts/render-nginx-hsts.sh, which renders the line
    # below in its place from SECURE_HSTS_SECONDS — the same env var Django's
    # SecurityMiddleware reads — so there is one source of truth for the
    # value. See docs/getting-started/installation.md (TLS modes) for the
    # per-mode default.
    __HSTS_HEADER_PLACEHOLDER__
    add_header X-Frame-Options           "DENY" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           $visiban_referrer_policy always;
    # Cache-Control per $visiban_cache_control (see map above); no `always`, so error
    # responses (e.g. a 404 under /assets/) are never marked cacheable.
    add_header Cache-Control $visiban_cache_control;
    # script-src: 'self' only — the theme-init.js script is served as a static
    # file rather than inline to avoid requiring 'unsafe-inline' here.
    # style-src: 'unsafe-inline' is retained. The React UI sets inline `style=`
    # attributes (dynamic widths, colors, drag positions) and component
    # libraries inject <style> elements at runtime; dropping it would need a
    # nonce/hash pipeline plus a separate style-src-attr policy, which is a
    # larger change than this header alignment.
    # connect-src: the SPA opens its Django Channels WebSocket on the same
    # origin it was served from, so the policy names that origin: 'self' plus
    # an explicit wss:// form of ${DOMAIN} (some browsers do not map 'self' to
    # ws/wss), with and without a port. ${DOMAIN} is rendered by envsubst at
    # container startup, like server_name.
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://${DOMAIN} wss://${DOMAIN}:*; font-src 'self'; frame-ancestors 'none'" always;

    # Must clear the largest application upload cap plus multipart framing:
    # IMPORT_MAX_SIZE_BYTES (25 MB Trello imports, #456) + 10 MB headroom.
    # If you raise IMPORT_MAX_SIZE_BYTES or MAX_UPLOAD_SIZE_BYTES, raise this.
    client_max_body_size 35M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Frontend static files (built React app)
    root  /usr/share/nginx/html;
    index index.html;

    # Hashed build output. A missing file must be a real 404: falling
    # through to the SPA catch-all answers a stale index.html's asset requests
    # with 200 text/html, which browsers report as a module MIME-type error
    # and a blank page (#1633). Caching headers come from the server-level
    # add_header driven by $visiban_cache_control (not sent on 404).
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API
    location /api/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        # Django's own SecurityMiddleware independently computes and sends its
        # own Strict-Transport-Security header on this proxied response. Hide
        # it so the client only ever sees the one nginx sends above (#1201) —
        # two HSTS headers on one response makes browsers ignore both (RFC 6797 §8.1).
        proxy_hide_header  Strict-Transport-Security;
    }

    # django-allauth browser-based OAuth callbacks (e.g. /accounts/google/login/callback/)
    location /accounts/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_hide_header  Strict-Transport-Security;
    }

    # MCP (Model Context Protocol) server — only reachable when the backend is
    # started with MCP_SERVER_ENABLED=true; otherwise Django 404s this path.
    # Streamable HTTP keeps a long-lived SSE response open, so buffering must be
    # off and the read timeout generous, as for /ws/ above — with proxy_buffering
    # on, nginx would hold event frames back until the buffer filled.
    location /mcp {
        proxy_pass         http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 86400s;
        proxy_hide_header  Strict-Transport-Security;
    }

    # WebSocket (Django Channels)
    location /ws/ {
        proxy_pass             http://backend:8000;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        proxy_read_timeout     86400s;
        proxy_hide_header      Strict-Transport-Security;
    }

    # Django admin — restricted to loopback only at the Nginx layer.
    # The Django AdminIPRestrictionMiddleware provides a second layer of defence,
    # but blocking at Nginx is preferable because it avoids hitting Django at all.
    # To access admin from outside loopback, SSH-tunnel to the server:
    #   ssh -L 8443:127.0.0.1:443 user@yourserver  then visit https://localhost:8443/admin/
    location /admin/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        limit_req zone=admin_login burst=2 nodelay;

        proxy_pass       http://backend:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Strict-Transport-Security;
    }

    # Django-served static files
    location /static/ {
        proxy_pass         http://backend:8000;
        proxy_hide_header  Strict-Transport-Security;
    }

    # Attachment downloads — proxied through Django for authentication and
    # board-membership checks. Django returns X-Accel-Redirect to hand off
    # the actual file transfer to Nginx without re-reading it through Python.
    location /media/ {
        proxy_pass         http://backend:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_hide_header  Strict-Transport-Security;
    }

    # Internal-only location used by X-Accel-Redirect responses from Django.
    # Not accessible directly from the internet — Nginx rejects external requests
    # that include an X-Accel-Redirect header targeting this path.
    location /protected-media/ {
        internal;
        alias /app/media/;
    }
}
