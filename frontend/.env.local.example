# frontend/.env.local — local development overrides for `npm run dev`
#
# Copy this file to .env.local and adjust as needed.
# .env.local is intentionally gitignored and excluded from Docker builds.
#
# NEVER commit .env.local — it contains machine-specific values that break
# production deployments when baked into the Docker image.
#
# Deployment matrix:
#
#   local dev (npm run dev / docker-compose.yml Vite target)
#     VITE_API_URL=http://localhost:8000   ← backend exposed directly on host
#
#   prod Docker Compose (docker-compose.prod.yml)
#     VITE_API_URL=                        ← empty; falls back to window.location.origin
#     API is proxied by nginx (/api/, /ws/) from the same origin — no override needed
#
#   Kubernetes / Helm
#     VITE_API_URL=                        ← empty; falls back to window.location.origin
#     API is proxied by nginx sidecar ConfigMap — no override needed
#
# The Docker image is always built with VITE_API_URL="" (the Dockerfile ARG default).
# Setting it here affects only `npm run dev` on your workstation.

VITE_API_URL=http://localhost:8000
