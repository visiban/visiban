          "></div><button type="button" aria-label="More actions" aria-haspopup="menu" data-testid="card-more-actions" class="absolute top-0 right-5 z-10 w-11 h-11 items-center justify-center rounded-full text-fg-secondary hidden [@media(pointer:coarse)]:group-focus-within:flex focus:outline-none focus:ring-2 focus:ring-primary-emphasis"><span aria-hidden="true" class="w-7 h-7 rounded-full bg-surface-hover border border-line-strong flex items-center justify-center leading-none">⋯</span></button><div class="relative px-2.5 py-2"><p class="leading-snug text-sm text-fg line-clamp-2 [@media(pointer:coarse)]:group-focus-within:pr-14">Card 3</p></div></div></div></div></div><button class="relative w-full text-left text-xs rounded px-1.5 py-1 transition mt-1 text-fg-faint hover:text-fg-secondary hover:bg-surface-hover/50 focus:outline-none focus:ring-2 focus:ring-primary-emphasis">+ Add card</button></div></div><div class="shrink-0 flex items-stretch" style="width: 16px;"><div class="w-px self-stretch bg-surface-active/70"></div><div class="flex-1 bg-sunken/70"></div><div class="w-px self-stretch bg-surface-active/70"></div></div><div class="absolute bottom-0 left-0 right-0 h-1.5 cursor-row-resize hover:bg-info/20 transition-colors group/resize"><div class="absolute bottom-0 left-0 right-0 h-px bg-info/0 group-hover/resize:bg-info/40 transition-colors"></div></div></div><div class="relative flex flex-col select-none w-full cursor-row-resize" style="height: 16px;"><div class="w-full h-px transition-colors bg-surface-active/70"></div><div class="flex-1 w-full transition-colors bg-sunken/70"></div><div class="w-full h-px transition-colors bg-surface-active/70"></div></div></div></div>"
