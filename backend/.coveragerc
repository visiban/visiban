[run]
source = .
# Measure with the PEP 669 sys.monitoring core (#2491). coverage.py's default C
# tracer pays a callback on every line event; sysmon disables each line after its
# first hit, so a long test run costs far less. Needs Python 3.12+ (CI's python:3.12).
# Its 3.12/3.13 gaps (no branch coverage, no dynamic contexts) don't apply: this
# config sets neither `branch` nor `dynamic_context`. Do NOT enable `branch = true`
# without moving off sysmon. Lives here, not in setup.cfg: coverage reads
# .coveragerc first and ignores setup.cfg when it exists.
core = sysmon
# Store file paths relative to the source root rather than absolute. The three
# parallel backend-test shards and the backend-test-coverage combine job can land
# on runners with different builds_dir values (e.g. /builds vs /tmp/builds); with
# absolute paths, `coverage report` in the combine job fails to resolve source
# ("No source for code: .../accounts/__init__.py") and aborts before the report.
# Relative paths make the combined data portable across runners.
relative_files = true
omit =
    */tests/*
    visiban/wsgi.py
    visiban/asgi.py
    boards/routing.py
    # mutmut hook (#1384): only ever imported by the nightly mutation job, never by pytest.
    mutmut_config.py

[report]
skip_covered = true
