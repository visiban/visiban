DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS defaults to CORS_ALLOWED_ORIGINS; override only if they differ.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# URL of the frontend SPA — used by allauth to redirect after OAuth login/logout.
FRONTEND_URL=http://localhost:5173

# Public hostname for OAuth callback URLs (default: localhost:8000).
# Set this to your domain in production.
SITE_DOMAIN=localhost:8000

DATABASE_URL=postgres://visiban:visiban@db:5432/visiban

# Redis — db 0 for Channels (WebSocket), db 1 for the Django cache (rate limiting, health checks).
# In Docker Compose these are set via the environment block; override here only for local dev.
# REDIS_URL=redis://redis:6379/0
# REDIS_CACHE_URL=redis://redis:6379/1

APP_VERSION=1.0.0-rc.11

# Admin panel IP restriction — production only.
# Comma-separated list of IPs/CIDRs allowed to access /admin/.
# Defaults to loopback only (127.0.0.1/::1) when not set.
# DJANGO_ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.1.100

# Email verification — set to "mandatory" to require email confirmation before
# login. Defaults to "none" (verification skipped, suitable for invite-only installs).
# ACCOUNT_EMAIL_VERIFICATION=none

# Production only — required by init-prod.sh and docker-compose.prod.yml
# DOMAIN=yourdomain.com
# DB_PASSWORD=change-me-in-production
#
# TLS mode — controls how the production stack handles HTTPS.
#   letsencrypt  (default) — obtain and auto-renew a Let's Encrypt certificate
#   selfsigned   — generate a self-signed certificate (staging / internal use)
#   none         — serve over plain HTTP (air-gapped / behind an external LB)
# TLS_MODE=letsencrypt
#
# Required only when TLS_MODE=letsencrypt:
# CERTBOT_EMAIL=admin@yourdomain.com
#
# Force-disable secure cookie flags (SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE).
# Set to true only when TLS_MODE=none or when TLS is terminated by an upstream
# proxy that does not set X-Forwarded-Proto. init-prod.sh sets this automatically
# for TLS_MODE=none.
# FORCE_INSECURE_COOKIES=false

# OAuth providers — all optional; leave blank to disable the provider on the login page.
# Configure at least one to enable social login.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab: https://gitlab.com/-/user_settings/applications
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Generic OIDC — for Keycloak, Authentik, Dex, Okta, or any OIDC-compliant IdP.
# All three vars must be set to enable the provider; leave all blank to disable.
# OIDC_SERVER_URL is the issuer URL (e.g. https://sso.example.com/realms/my-realm).
# Visiban appends /.well-known/openid-configuration automatically — do not include
# that path in OIDC_SERVER_URL.
# OIDC_PROVIDER_NAME sets the label on the login button (default: "SSO").
# OIDC_CLIENT_ID=
# OIDC_SECRET=
# OIDC_SERVER_URL=https://sso.example.com/realms/my-realm
# OIDC_PROVIDER_NAME=SSO
